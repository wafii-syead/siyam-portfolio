# Optional at first. Add the exact live origin after Vercel gives you a URL.
SITE_URL=https://your-portfolio.vercel.app

# Server-only. Leave empty to use social contact links and hide the form.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Optional additional exact origins, comma separated. Never use wildcards.
CONTACT_ALLOWED_ORIGINS=
